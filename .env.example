# Reference only: export variables in your shell; this file is not auto-loaded.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
P2RANK_PATH=
PANACEA_MODEL=
DRUGASSIST_MODEL_PATH=
HF_TOKEN=
# Optional: trained binary single-logit checkpoint; never substitute a base encoder.
MEDITAB_MODEL_PATH=

DEEPSEEK_MAX_TOKENS=4096
# Optional local ChemFM: hERG and Ames classification only; requires CUDA + PEFT.
CHEMFM_BACKEND=remote

DRUGASSIST_GPU_LAYERS=-1
DRUGASSIST_SEED=42
